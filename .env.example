SECRET_KEY=change-this-to-a-long-random-string
# Path to the service-account key you download from Firebase (keep it secret)
FIREBASE_CREDENTIALS=serviceAccountKey.json
# For online hosting (Render etc.) paste the WHOLE JSON file content here instead:
FIREBASE_CREDENTIALS_JSON=
BASE_URL=http://localhost:5000
TIMEZONE=Asia/Manila

# ---- Email (pick ONE way) ----
# 1) Resend (recommended; works on Render's free plan because it uses HTTPS, not SMTP)
RESEND_API_KEY=
# Sender. To email students you must verify a domain you own in Resend and use it here,
# for example: QlickIn <noreply@yourdomain.com>
# (With no domain, onboarding@resend.dev only delivers to your own Resend account email - testing only.)
MAIL_FROM=QlickIn <onboarding@resend.dev>
# 2) Gmail SMTP (works on your own computer; blocked on Render's free plan)
SMTP_USER=
SMTP_PASSWORD=
# Leave all of them blank to print emails in the terminal and save email_preview.html.
